# GEMINI_API_KEY: Required for Gemini AI API calls (Chat, Vision, Image Studio, Veo Video, Lyria Music, TTS, Transcription, Search & Maps Grounding).
# Configure this key securely via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional model and voice configuration defaults:
AI_DEFAULT_MODEL=gemini-3.5-flash
TTS_VOICE_ID=Puck
